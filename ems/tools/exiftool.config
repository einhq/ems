# exiftool's configuration for EMS's reads (`-config`, ahead of every other argument).
#
# EMS reads with `-n`, which leaves a lens that only its maker notes identify as a number:
# Pentax's and Ricoh's `LensType` and `LensID` are `8 215`, which exiftool's lens table names
# `smc PENTAX-DA 18-135mm F3.5-5.6 ED AL [IF] DC WR` when it prints values. `LensName` is that
# printed `LensID`, kept beside the numeric one. It is left out when printing changes nothing
# or the table does not know the lens (`Unknown (8 999)`, `n/a`).

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::Composite' => {
        LensName => {
            Require => 'LensID',
            ValueConv => q{
                my $name = $prt[0];
                return undef if not defined $name or $name eq $val[0] or $name =~ m{^(Unknown\b|n/a$)}i;
                return $name;
            },
        },
    },
);

1;
